---
import { getCollection } from 'astro:content';
import PostPage from '../../components/PostPage.astro';
import { filterByLocale } from '../../utils/i18n';
import { getEnPostUrl } from '../../utils/url';

export async function getStaticPaths() {
  const posts = filterByLocale(await getCollection('blog'), 'en');
  // Same URL the rest of the site links to: '/en/national-championship/nc-2026/'
  // becomes the param 'national-championship/nc-2026'.
  return posts.map((post) => ({
    params: { slug: getEnPostUrl(post).replace(/^\/en\/|\/$/g, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostPage post={post} locale="en" />
