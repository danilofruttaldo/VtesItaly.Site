---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import CommunityPage from '../../../components/CommunityPage.astro';
import { filterByLocale } from '../../../utils/i18n';
import { todayLocalIso } from '../../../utils/today';
import { postEndDay } from '../../../utils/calendar';
import { firstPastIndex } from '../../../utils/timeline';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = filterByLocale(await getCollection('blog'), 'en')
    .filter((p) => p.data.category === 'comunita')
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  // Past = over by its last day: a multi-day event in progress stays above.
  const today = todayLocalIso();
  const pastStartGlobal = firstPastIndex(posts, today, (p) => ({ date: postEndDay(p) }));
  return paginate(posts, { pageSize: 8 }).map((path) => ({
    ...path,
    props: { ...path.props, pastStartGlobal },
  }));
}) satisfies GetStaticPaths;

const { page, pastStartGlobal } = Astro.props as typeof Astro.props & { pastStartGlobal: number };
---

<CommunityPage page={page} pastStartGlobal={pastStartGlobal} locale="en" />
