---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { heroSrcset } from '../utils/image';
import '../styles/prose.css';
import Base from '../layouts/Base.astro';
import JsonLd from './JsonLd.astro';
import ShareButtons from './ShareButtons.astro';
import TourEdition from './TourEdition.astro';
import EventEdition from './EventEdition.astro';
import LeagueEdition from './LeagueEdition.astro';
import PageHero from './PageHero.astro';
import WosStandings from './WosStandings.astro';
import LinkButton from './LinkButton.astro';
import AlbumGallery from './AlbumGallery.astro';
import { mainPages } from '../data/pages';
import { categoryLabels, categoryUrls, typeTagLabels as typeTagLabelsMap } from '../data/categories';
import { cities } from '../data/cities';
import { useTranslations, formatLocalDate } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { computeTourStatus, computeEventStatus, resolveLinkLabel, toStageDays } from '../utils/status';
import { firstEventDay, isoDay, lastEventDay } from '../utils/date';
import { isLeaguePost } from '../utils/post';
import { contentGitDates } from '../utils/git-dates';
import { publishedDay, articleJsonLd, eventJsonLd, postDescription, stageEventsJsonLd } from '../utils/structured-data';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);

const postLinks = (post.data.links ?? [])
  .filter((l) => !l.locale || l.locale === locale)
  .map((l) => ({ ...l, label: resolveLinkLabel(l) }));
const postLinksAfter = (post.data.linksAfter ?? [])
  .filter((l) => !l.locale || l.locale === locale)
  .map((l) => ({ ...l, label: resolveLinkLabel(l) }));

const label = categoryLabels[post.data.category]?.[locale] || post.data.category;
const backUrl = categoryUrls[post.data.category]?.[locale] || t.routes.comunita;
const backLabel = categoryLabels[post.data.category]?.[locale] || t.not_found.community;

const localTypeTags = Object.fromEntries(Object.entries(typeTagLabelsMap).map(([k, v]) => [k, v[locale]]));
const typeTag = post.data.tags?.find((tag: string) => localTypeTags[tag]);
const typeLabel = typeTag ? localTypeTags[typeTag] : null;

// Map city slugs (tags are always the Italian slug) to their principato page
const cityMap = new Map(
  cities.map((c) => [
    c.slug.it,
    { name: c.name[locale], url: locale === 'en' ? `/en/domains/${c.slug.en}/` : `/principati/${c.slug.it}/` },
  ]),
);

const isTourWithStages = post.data.category === 'tour' && post.data.stages && post.data.stages.length > 0;
const tourStatus = isTourWithStages ? computeTourStatus(post.data.stages!) : null;
const tourStagesJson = isTourWithStages ? JSON.stringify(toStageDays(post.data.stages!)) : null;
const isGp = post.data.category === 'grand-prix';
const isNc = post.data.category === 'nazionale';
// A European Championship edition with its programme reads like a GP/NC page.
const isEc = post.data.category === 'europeo' && (post.data.events?.length ?? 0) > 0;
const forceArticle = post.data.pageLayout === 'article';
const isLeague = isLeaguePost(post);
const isCommunityEvent =
  !forceArticle && post.data.category === 'comunita' && !isLeague && !!(post.data.venue || post.data.events.length > 0);
const isEventPage = isGp || isNc || isEc || isCommunityEvent || isLeague;
// Status runs from the first event day (a Friday side event) to the last one.
const eventDateStr = firstEventDay(post.data.events, isoDay(post.data.date));
const eventEndStr = lastEventDay(post.data.events, isoDay(post.data.date));
const gpStatus = isEventPage ? computeEventStatus(new Date(eventDateStr), eventEndStr) : null;
const communityCity = isCommunityEvent || isLeague ? cities.find((c) => post.data.tags.includes(c.slug.it)) : null;
const usePageHero = isTourWithStages || isEventPage;
// On an event page the poster, not the banner above it, is the LCP image.
const heroYieldsToPoster = isEventPage && !!post.data.poster;
const gitDates = post.filePath ? contentGitDates().get(post.filePath) : undefined;
const ldPage = {
  url: new URL(Astro.url.pathname, Astro.site).href,
  locale,
  published: gitDates?.created,
  modified: gitDates?.modified,
};
const eventLd = isEventPage ? eventJsonLd(post.data, Astro.site!, ldPage) : null;
const stageLds = isTourWithStages ? stageEventsJsonLd(post.data, Astro.site!, ldPage) : [];
const pageMeta =
  usePageHero && !isCommunityEvent && !isLeague ? mainPages.find((p) => p.category === post.data.category) : null;
---

<Base
  title={post.data.seoTitle || post.data.title}
  description={postDescription(post.data)}
  ogImage={post.data.poster || post.data.featuredImage}
  ogType="article"
  publishedTime={new Date(publishedDay(post.data.date, gitDates?.created))}
>
  <JsonLd slot="head" data={articleJsonLd(post.data, Astro.site!, ldPage)} />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(t.routes.home, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: label, item: new URL(backUrl, Astro.site).href },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: new URL(Astro.url.pathname, Astro.site).href,
        },
      ],
    }}
  />
  {isEventPage && eventLd && <JsonLd slot="head" data={eventLd} />}
  {stageLds.map((ld) => (
    <JsonLd slot="head" data={ld} />
  ))}

  {/* PageHero for tour, GP/NC and community events (with principato header) */}
  {usePageHero && pageMeta ? (
    <PageHero title="" image={pageMeta.headerImage} priority={!heroYieldsToPoster} />
  ) : (isCommunityEvent || isLeague) && communityCity ? (
    <PageHero title="" image={communityCity.headerImage} priority={!heroYieldsToPoster} />
  ) : (isCommunityEvent || isLeague) && post.data.cityHeader ? (
    <PageHero title="" image={post.data.cityHeader} priority={!heroYieldsToPoster} />
  ) : (
    post.data.featuredImage && (
      <div class="post__hero-wrap">
        {/* Decorative: the title is the h1 below. The LCP of the page. */}
        <img
          src={post.data.featuredImage}
          srcset={heroSrcset(post.data.featuredImage)}
          sizes={heroSrcset(post.data.featuredImage) ? '100vw' : undefined}
          alt=""
          class="post__hero"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="post__hero-overlay" />
      </div>
    )
  )}

  <article class="post">
    <div class:list={['container', !(isEventPage || isTourWithStages || forceArticle) && 'container--narrow']}>
      {/* Back link */}
      <a href={backUrl} class="post__back">
        &larr; {backLabel}
      </a>

      {/* Title & description */}
      <header class="post__header">
        <div class="post__title-row">
          <h1 class="post__title">{post.data.title}</h1>
          {isTourWithStages && tourStatus && (
            <span
              class:list={['post__status', tourStatus === 'past' ? 'post__status--finished' : 'post__status--active']}
              data-tour-stages={tourStagesJson}
              data-label-live={t.status.live}
              data-label-upcoming={t.status.upcoming}
              data-label-past={t.status.past}
            >
              {tourStatus === 'past' ? t.status.past : tourStatus === 'live' ? t.status.live : t.status.upcoming}
            </span>
          )}
          {isEventPage && !isLeague && gpStatus && (
            <span
              class:list={['post__status', gpStatus === 'past' ? 'post__status--finished' : 'post__status--active']}
              data-event-date={eventDateStr}
              data-event-end-date={eventEndStr}
              data-label-live={t.status.live}
              data-label-upcoming={t.status.upcoming}
              data-label-past={t.status.past}
            >
              {gpStatus === 'live' ? t.status.live : gpStatus === 'upcoming' ? t.status.upcoming : t.status.past}
            </span>
          )}
        </div>
        {!usePageHero && !isCommunityEvent && !isLeague && post.data.excerpt && (
          <p class="post__excerpt">{post.data.excerpt}</p>
        )}
      </header>

      {/* Metadata: category + date, then tags */}
      <div class="post__meta-row">
        <div class="post__meta-left">
          <span class="post__category">{label}</span>
          {typeLabel && <span class="post__type-tag">{typeLabel}</span>}
        </div>
        <time class="post__date" datetime={isoDay(post.data.date)}>
          {formatLocalDate(post.data.date, locale)}
        </time>
      </div>
      {post.data.tags &&
        post.data.tags.filter((t) => !['contest', 'torneo', 'lega', 'prerelease', 'annuncio'].includes(t)).length >
          0 && (
          <div class="post__tags-row">
            <div class="post__tags">
              {post.data.tags
                .filter((t) => !['contest', 'torneo', 'lega', 'prerelease', 'annuncio'].includes(t))
                .map((tag) => {
                  const city = cityMap.get(tag);
                  return city ? (
                    <a href={city.url} class="post__tag post__tag--city">
                      {city.name}
                    </a>
                  ) : (
                    <span class="post__tag">{tag}</span>
                  );
                })}
            </div>
          </div>
        )}
      <hr class="post__divider" />

      {/* Layout per categoria */}
      {isTourWithStages ? (
        <TourEdition post={post} locale={locale} />
      ) : isLeague ? (
        <LeagueEdition post={post} locale={locale} />
      ) : isEventPage ? (
        <EventEdition post={post} locale={locale} />
      ) : (
        <>
          <div class="post__content prose">
            <Content />
          </div>
          {postLinks.length > 0 && (
            <div class="post__links">
              {postLinks.map((link) => (
                <LinkButton url={link.url} label={link.label} />
              ))}
            </div>
          )}
          {post.data.standingsUrl && post.data.standingsUrl.includes('wos') && (
            <>
              <hr class="post__divider" />
              <WosStandings dataUrl={post.data.standingsUrl} locale={locale} />
            </>
          )}
          {postLinksAfter.length > 0 && (
            <div class="post__links">
              {postLinksAfter.map((link) => (
                <LinkButton url={link.url} label={link.label} />
              ))}
            </div>
          )}
          {post.data.album && <AlbumGallery slug={post.data.album} locale={locale} />}
        </>
      )}

      <ShareButtons />

      {/* Footer: back button */}
      <div class="post__footer">
        <a href={backUrl} class="btn">
          &larr; {backLabel}
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  /* Hero */
  .post__hero-wrap {
    position: relative;
    width: 100%;
    max-height: 420px;
    overflow: hidden;
  }
  .post__hero {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }
  .post__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(18, 20, 22, 0.4) 0%, rgba(18, 20, 22, 0.3) 50%, var(--color-base) 100%);
  }

  /* Layout */
  .post {
    padding-bottom: 48px;
  }

  /* Back link */
  .post__back {
    display: inline-block;
    margin-top: 24px;
    margin-bottom: 16px;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    text-decoration: none;
  }
  .post__back:hover {
    color: var(--color-accent-1);
  }

  /* Header: title + excerpt */
  .post__header {
    margin-bottom: 16px;
  }
  .post__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .post__title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: var(--leading-tight);
    margin-bottom: 12px;
  }
  .post__title-row .post__title {
    margin-bottom: 0;
  }
  .post__status {
    font-size: var(--font-size-3xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    padding: 2px 8px;
    border-radius: var(--radius);
  }
  .post__status--active {
    color: var(--color-gold);
    background: rgba(201, 168, 76, 0.12);
  }
  .post__status--finished {
    color: var(--color-muted);
    background: rgba(155, 155, 155, 0.1);
  }
  .post__excerpt {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Meta: category + date row, tags row */
  .post__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
  }
  .post__meta-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .post__tags-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 8px;
  }
  .post__category {
    font-size: var(--font-size-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-gold);
    background: rgba(201, 168, 76, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius);
  }
  .post__type-tag {
    font-size: var(--font-size-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-gold);
    background: rgba(201, 168, 76, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius);
  }
  .post__date {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
  .post__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-left: auto;
  }
  .post__tag {
    font-size: var(--font-size-2xs);
    font-weight: 500;
    padding: 2px 8px;
    border-radius: var(--radius);
    background: var(--color-accent-light);
    color: var(--color-accent-1);
    text-transform: capitalize;
  }
  .post__tag--city {
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .post__tag--city:hover {
    background: rgba(139, 26, 43, 0.25);
    color: var(--color-accent-2);
  }

  /* Divider */
  .post__divider {
    border: none;
    border-top: 1px solid rgba(139, 26, 43, 0.15);
    margin: 24px 0;
  }

  /* Links */
  .post__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
    margin-bottom: 28px;
  }
  .post__link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    padding: 8px 18px;
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: var(--radius);
    background: rgba(201, 168, 76, 0.08);
    transition: all 0.2s ease;
  }
  .post__link-btn:hover {
    background: rgba(201, 168, 76, 0.18);
    border-color: rgba(201, 168, 76, 0.5);
  }
  .post__link-btn--web {
    color: var(--color-web);
    border-color: rgba(74, 144, 217, 0.3);
    background: rgba(74, 144, 217, 0.06);
  }
  .post__link-btn--web:hover {
    color: var(--color-web);
    background: rgba(74, 144, 217, 0.16);
    border-color: rgba(74, 144, 217, 0.5);
  }
  .post__link-btn svg {
    flex-shrink: 0;
  }

  /* Footer */
  .post__footer {
    text-align: center;
    margin: 40px 0;
  }

  @media (max-width: 544px) {
    .post__hero {
      height: 260px;
    }
    .post__hero-wrap {
      max-height: 260px;
    }
    .post__tags {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
