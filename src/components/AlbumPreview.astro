---
/**
 * A small preview of an album on foto.vtesitaly.com: its title, a few thumbs
 * spread across it and a link to the whole album. Used for the albums of side
 * events, next to the main event's full AlbumGallery.
 */
import { albumFor, previewPhotos } from '../utils/albums';
import { useTranslations, type Locale } from '../utils/i18n';

interface Props {
  slug: string;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const t = useTranslations(locale);
const album = albumFor(slug);
---

{album && (
  <div class="album-preview">
    <h3 class="album-preview__title">
      {album.title}{' '}
      <span class="album-preview__count">
        · {album.photos.length} {t.post.photo}
      </span>
    </h3>
    <ul class="album-preview__grid">
      {previewPhotos(album).map((p, i) => (
        <li>
          <a href={album.url} target="_blank" rel="noopener noreferrer" class="album-preview__item">
            <img
              src={p.thumb}
              alt={p.caption ?? `${album.title} - ${t.post.photo} ${i + 1}`}
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
    <p class="album-preview__more">
      <a href={album.url} target="_blank" rel="noopener noreferrer">
        {t.post.album_link} &rarr;
      </a>
    </p>
  </div>
)}

<style>
  .album-preview + .album-preview {
    margin-top: 24px;
  }
  .album-preview__title {
    font-size: var(--font-size-md);
    color: var(--color-gold);
    margin: 0 0 10px;
  }
  .album-preview__count {
    color: var(--color-muted);
    font-weight: 400;
  }
  .album-preview__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .album-preview__item {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .album-preview__item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }
  .album-preview__item:hover img {
    opacity: 0.85;
  }
  .album-preview__more {
    margin: 10px 0 0;
    font-size: var(--font-size-sm);
  }
  @media (max-width: 480px) {
    .album-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
