---
import { getCollection } from 'astro:content';
import CityPage from '../../components/CityPage.astro';
import { cities } from '../../data/cities';
import { filterByLocale } from '../../utils/i18n';
import { buildCityCards } from '../../utils/url';

export async function getStaticPaths() {
  const allPosts = filterByLocale(await getCollection('blog'), 'it');
  return cities.map((city) => {
    const cityTag = city.slug.it;
    const cards = buildCityCards(allPosts, cityTag, (post) => `/${post.data.category}/${post.id}/`);
    return {
      params: { slug: city.slug.it },
      props: { city, cards },
    };
  });
}

const { city, cards } = Astro.props;
---

<CityPage city={city} cards={cards} locale="it" />
