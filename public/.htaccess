# .htaccess di vtesitaly.com, versionato nel repository dal 2026-10-16 e
# pubblicato insieme al sito: si modifica qui, non sul server.
# Spiegazione blocco per blocco: docs/htaccess.md.

# Intestazioni di sicurezza. "always" perche' valgano anche su 301, 404 e
# pagine di errore: con "Header set" mancavano proprio li'.
# X-XSS-Protection non c'e' piu': i browser l'hanno abbandonato.
# La CSP degli script sta nel meta che genera Astro (security.csp, con gli
# hash); qui solo le direttive che un meta non puo' portare o che non
# riguardano gli script. Le due politiche si applicano insieme.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    # Senza condizione: sulle risposte in http il browser lo ignora comunque,
    # e "env=HTTPS" lo faceva sparire dove la variabile non arriva. Niente
    # preload.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Upgrade lo aggiunge Apache con HTTP/2 disponibile: su una risposta
    # HTTP/2 e' vietato, e Safari rifiuta la pagina.
    Header always unset Upgrade
</IfModule>

# Charset dichiarato anche per i file di testo che non sono HTML.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset utf-8 .js .mjs .css .json .webmanifest .xml .txt
</IfModule>

# Cache. I file sotto /_astro/ hanno l'impronta nel nome: cambiano indirizzo
# quando cambiano, quindi un anno e immutable. Lo stesso per i file di
# Pagefind con l'hash nel nome (fragment/, index/, filter/ e i *.pf_*);
# pagefind.js, pagefind-entry.json, pagefind-ui.* e wasm.*.pagefind hanno
# nomi fissi e restano no-cache. Immagini, PDF e icone hanno nomi fissi e un
# file puo' essere sostituito: una settimana, poi si ricontrolla.
# Tutto il resto (HTML, sw.js, manifest, sitemap, /api/) va ricontrollato a
# ogni visita, altrimenti una pagina aggiornata resta vecchia nel browser.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/pagefind/(?:(?:fragment|index|filter)/|.*\.pf_[a-z]+$)#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </ElseIf>
    <ElseIf "%{REQUEST_URI} =~ m#\.(?:webp|avif|png|jpe?g|gif|svg|ico|pdf)$#">
        Header always set Cache-Control "public, max-age=604800, must-revalidate"
    </ElseIf>
    <Else>
        Header always set Cache-Control "no-cache"
    </Else>
</IfModule>

# Niente compressione per i formati gia' compressi.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(?:webp|avif|png|jpe?g|gif|woff2|pdf)$" no-gzip no-brotli
</IfModule>

# File che non devono uscire.
<FilesMatch "^(error_log|\.htaccess)">
    Require all denied
</FilesMatch>

Options -Indexes

# Pagina 404 vera. Fino al 2026-10-16 qui c'era il ripiego da SPA verso
# /index.html, che rispondeva con la home e codice 200 a ogni indirizzo
# inesistente: il sito e' completamente statico, non serve.
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
    ErrorDocument 404 /en/404/index.html
</If>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # www -> dominio senza www.
    RewriteCond %{HTTP_HOST} ^www\.vtesitaly\.com$ [NC]
    RewriteRule ^(.*)$ https://vtesitaly.com/$1 [R=301,L]

    # Guide archon unificate: 301 veri al posto delle pagine con meta refresh
    # di Astro (astro.config.mjs, redirects), che restano come rete di sicurezza.
    RewriteRule ^guide/archon-(?:principi|giocatori|leghe)/?$ https://vtesitaly.com/guide/archon-italia/ [R=301,L]
    RewriteRule ^en/guides/archon-(?:principi|giocatori|leghe)/?$ https://vtesitaly.com/en/guides/archon-italia/ [R=301,L]

    # Articoli cancellati a marzo 2026: l'indirizzo era ancora linkato fuori,
    # si porta all'elenco della comunita' invece di un 404. Vengono prima delle
    # regole generiche su /blog/ e /en/comunita/ qui sotto, che li manderebbero
    # a una pagina inesistente.
    RewriteRule ^(?:blog|comunita)/(?:7-campionato-milanese-di-vtes|8-campionato-milanese-di-vtes|il-torneo-dello-stile-treviso|lestate-emiliana-si-tinge-di-bleed|litalia-domina-lec-2024-a-varsavia)/?$ https://vtesitaly.com/comunita/ [R=301,L]
    RewriteRule ^en/(?:blog|comunita|community)/(?:7-campionato-milanese-di-vtes|8-campionato-milanese-di-vtes|il-torneo-dello-stile-treviso|lestate-emiliana-si-tinge-di-bleed|litalia-domina-lec-2024-a-varsavia)/?$ https://vtesitaly.com/en/community/ [R=301,L]

    # Articolo della lega di Treviso rinominato: il vecchio slug porta al nuovo,
    # in un solo salto anche dai vecchi percorsi /en/comunita/ e /blog/.
    RewriteRule ^(?:blog|comunita)/bleeding-the-vine-lega-vtes-treviso/?$ https://vtesitaly.com/comunita/bleeding-the-vine-lega-treviso/ [R=301,L]
    RewriteRule ^en/(?:blog|comunita|community)/bleeding-the-vine-lega-vtes-treviso/?$ https://vtesitaly.com/en/community/bleeding-the-vine-lega-treviso/ [R=301,L]

    # Indirizzi delle versioni precedenti del sito, ancora condivisi fuori
    # (infopack mandati per email, link sui social). Fino al 2026-10-16
    # rispondevano perche' i vecchi file restavano in public_html: il deploy
    # a release li ha tolti, e questi 301 li portano dove stanno oggi.
    RewriteRule ^docs/gp-(\d{4})/(.+)$ https://vtesitaly.com/gp/gp-$1/$2 [R=301,L]
    RewriteRule ^docs/nc-(\d{4})/(.+)$ https://vtesitaly.com/nc/nc-$1/$2 [R=301,L]
    RewriteRule ^docs/wos-(\d{4})/(.+)$ https://vtesitaly.com/ev/wos-$1/$2 [R=301,L]
    RewriteRule ^docs/tour/regolamento-tour-2026\.pdf$ https://vtesitaly.com/tour/tour-2026/infopack-tour-2026-it.pdf [R=301,L]
    RewriteRule ^docs/tour/rules-tour-2026\.pdf$ https://vtesitaly.com/tour/tour-2026/infopack-tour-2026-en.pdf [R=301,L]
    RewriteRule ^blog/?$ https://vtesitaly.com/comunita/ [R=301,L]
    RewriteRule ^blog/(.+?)/?$ https://vtesitaly.com/comunita/$1/ [R=301,L]
    RewriteRule ^week-of-sabbat/?$ https://vtesitaly.com/comunita/week-of-sabbat-2025/ [R=301,L]

    # Sezione inglese delle versioni precedenti: blog e comunita' sotto i nomi
    # italiani, il campionato nazionale come /en/nazionale/, la Week of Sabbat
    # come pagina a parte. Gli slug degli articoli sono rimasti gli stessi.
    RewriteRule ^en/(?:blog|comunita)/?$ https://vtesitaly.com/en/community/ [R=301,L]
    RewriteRule ^en/(?:blog|comunita)/(.+?)/?$ https://vtesitaly.com/en/community/$1/ [R=301,L]
    RewriteRule ^en/nazionale/nazionale-(\d{4})/?$ https://vtesitaly.com/en/national-championship/nc-$1/ [R=301,L]
    RewriteRule ^en/week-of-sabbat/?$ https://vtesitaly.com/en/community/week-of-sabbat-2025/ [R=301,L]

    # Regolamenti del tour 2026 con il vecchio nome, sostituiti dagli infopack.
    RewriteRule ^tour/tour-2026/regolamento-tour-2026\.pdf$ https://vtesitaly.com/tour/tour-2026/infopack-tour-2026-it.pdf [R=301,L]
    RewriteRule ^tour/tour-2026/rules-tour-2026\.pdf$ https://vtesitaly.com/tour/tour-2026/infopack-tour-2026-en.pdf [R=301,L]

    # Vecchia pagina del Grand Prix sotto /gp/gp-AAAA/: oggi la cartella tiene
    # solo immagini e PDF, la pagina sta in /grand-prix/grand-prix-AAAA/.
    RewriteRule ^gp/gp-(\d{4})/?$ https://vtesitaly.com/grand-prix/grand-prix-$1/ [R=301,L]

    # Cartelle senza index.html (/api/, /fonts/, /_astro/...): con -Indexes
    # Apache risponderebbe con la sua pagina 403. Si serve il 404 del sito.
    # Le cartelle con index.html non sono toccate, quindi mod_dir aggiunge
    # ancora la barra finale; .well-known resta agli strumenti dell'hosting.
    # Sta dopo i redirect, che altrimenti non scatterebbero sulle cartelle.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteCond %{REQUEST_URI} !^/\.well-known(?:/|$)
    RewriteRule ^ - [R=404,L]
</IfModule>
