---
/**
 * Reusable responsive `<img>` for WebP display images. Emits a `srcset` of the
 * downscaled variants generated by `scripts/build-poster-variants.mjs` (via
 * `responsiveImage()`), with `width`/`height` from the source header so the box
 * is reserved (no CLS). Falls back to a plain `<img>` when no variants exist
 * (dev without prebuild, or a missing file), so it never breaks.
 *
 * Renders a bare `<img>` — scoped CSS targeting the parent (e.g. `.gp-poster
 * img`) still applies. `sizes` is required and describes the display slot.
 */
import { responsiveImage } from '../utils/image';

interface Props {
  src: string | undefined;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, sizes, class: className, loading = 'lazy', decoding = 'async', fetchpriority } = Astro.props;
const img = responsiveImage(src);
---

<img
  src={img.src}
  srcset={img.srcset}
  sizes={img.srcset ? sizes : undefined}
  width={img.width}
  height={img.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
/>
