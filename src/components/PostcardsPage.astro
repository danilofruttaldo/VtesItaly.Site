---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ShareButtons from './ShareButtons.astro';
import { mainPages } from '../data/pages';
import { postcardGalleries } from '../data/postcards';
import { useTranslations } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = mainPages.find((p) => p.slug.it === 'cartoline')!;
const t = useTranslations(locale);
const galleries = postcardGalleries.map((g) => ({
  title: g.title[locale],
  subtitle: g.subtitle[locale],
  images: g.images.map((img) => ({
    src: img.src,
    alt: img.alt,
    highlight: img.highlight
      ? {
          label: img.highlight.label?.[locale] ?? null,
          title: img.highlight.title ?? null,
          imageCaption: img.highlight.imageCaption?.[locale] ?? null,
          caption: img.highlight.caption[locale],
        }
      : null,
  })),
}));
---

<Base title={page.title[locale]} description={page.description[locale]} ogImage={page.ogImage}>
  <PageHero title={page.title[locale]} image={page.headerImage} />
  <section class="section">
    <div class="container container--narrow">
      <p class="tagline">{t.postcards.tagline}</p>
      <p>
        <Fragment set:html={t.postcards.intro} />
      </p>

      <h2 class="section-subtitle">{t.postcards.why_title}</h2>
      <p>{t.postcards.why_text}</p>
    </div>

    <hr class="divider" />

    <div class="container">
      {galleries.map((gallery, i) => (
        <div class="gallery-section" data-gallery>
          <button
            type="button"
            class="gallery-header"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`gallery-body-${i}`}
          >
            <div class="gallery-header-text">
              <h3 class="gallery-title">{gallery.title}</h3>
              <p class="gallery-subtitle">{gallery.subtitle}</p>
            </div>
            <span class="gallery-count">{gallery.images.length}</span>
            <span class="gallery-chevron" aria-hidden="true">
              &#8250;
            </span>
          </button>

          <div class="gallery-body" id={`gallery-body-${i}`}>
            <div class="gallery-body-inner">
              {gallery.images
                .filter((img) => img.highlight)
                .map((img) => (
                  <figure class="highlight-card">
                    <img
                      class="highlight-image"
                      src={img.src}
                      alt={img.alt}
                      width="400"
                      height="300"
                      loading="lazy"
                      decoding="async"
                      role="button"
                      tabindex="0"
                    />
                    <div class="highlight-text">
                      {img.highlight!.label && <span class="highlight-label">{img.highlight!.label}</span>}
                      {img.highlight!.title && <span class="highlight-title">{img.highlight!.title}</span>}
                      <figcaption class="highlight-caption">{img.highlight!.caption}</figcaption>
                      {img.highlight!.imageCaption && (
                        <span class="highlight-image-caption">{img.highlight!.imageCaption}</span>
                      )}
                    </div>
                  </figure>
                ))}

              {/* Desktop: grid */}
              <div class="gallery-grid">
                {gallery.images
                  .filter((img) => !img.highlight)
                  .map((img) => (
                    <figure class="gallery-item" role="button" tabindex="0">
                      <img src={img.src} alt={img.alt} width="400" height="300" loading="lazy" decoding="async" />
                    </figure>
                  ))}
              </div>

              {/* Mobile: slider */}
              {/* Only the first slide has its `src`: the others carry it in
                    `data-src` and get it when they come near the visible
                    area of the track. With plain loading="lazy" the browser
                    fetched every card of every gallery on a phone, closed
                    galleries included: 1.6 MB for a page read one card at a
                    time. */}
              <div class="gallery-slider">
                <div class="slider-track" tabindex="0" aria-label={`${gallery.title}: ${t.postcards.slider_label}`}>
                  {gallery.images
                    .filter((img) => !img.highlight)
                    .map((img, j) => (
                      <figure class="slider-slide">
                        {j === 0 ? (
                          <img src={img.src} alt={img.alt} width="400" height="300" loading="lazy" decoding="async" />
                        ) : (
                          <img data-src={img.src} alt={img.alt} width="400" height="300" decoding="async" />
                        )}
                      </figure>
                    ))}
                </div>
                {gallery.images.filter((img) => !img.highlight).length > 1 && (
                  <div class="slider-dots">
                    {gallery.images
                      .filter((img) => !img.highlight)
                      .map((_, j) => (
                        <button
                          type="button"
                          class={`slider-dot ${j === 0 ? 'is-active' : ''}`}
                          aria-label={`${t.calendar.slide_label} ${j + 1}`}
                        />
                      ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
      <ShareButtons />
    </div>
  </section>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <img class="lightbox-img" id="lightbox-img" alt="" />
  </div>
</Base>

<style>
  .section {
    padding: 40px 0 48px;
  }
  .tagline {
    font-size: var(--font-size-md);
    font-style: italic;
    color: var(--color-gold);
    margin-bottom: 16px;
  }
  .section-subtitle {
    font-size: clamp(1rem, 3vw, 1.15rem);
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 8px;
    letter-spacing: var(--tracking-wide);
  }
  .divider {
    border: none;
    border-top: 1px solid var(--color-accent-light);
    margin: 32px auto;
    max-width: var(--content-width);
  }

  /* --- Accordion header --- */
  .gallery-section {
    margin-bottom: 8px;
  }
  .gallery-header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease;
  }
  .gallery-header:hover {
    background: rgba(201, 168, 76, 0.08);
  }
  .gallery-header-text {
    flex: 1;
  }
  .gallery-title {
    font-size: var(--font-size-md);
    font-weight: 700;
    color: var(--color-gold);
    margin: 0;
  }
  .gallery-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    margin: 0;
  }
  .gallery-count {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    background: rgba(201, 168, 76, 0.15);
    border-radius: 999px;
    padding: 2px 10px;
    flex-shrink: 0;
  }
  .gallery-chevron {
    font-size: 1.4rem;
    color: var(--color-gold);
    transition: transform 0.25s ease;
    flex-shrink: 0;
    line-height: 1;
  }
  .gallery-header[aria-expanded='true'] .gallery-chevron {
    transform: rotate(90deg);
  }

  /* --- Accordion body --- */
  .gallery-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    overflow: hidden;
  }
  .gallery-body > * {
    overflow: hidden;
  }
  .gallery-header[aria-expanded='true'] + .gallery-body {
    grid-template-rows: 1fr;
    padding: 16px 0 24px;
  }

  /* --- Highlight card --- */
  .highlight-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 0 auto 24px;
    max-width: 720px;
    padding: 20px;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(201, 168, 76, 0.08), rgba(201, 168, 76, 0.02));
    box-shadow: 0 0 0 4px rgba(201, 168, 76, 0.12);
    text-align: center;
  }
  .highlight-image {
    width: 100%;
    max-width: 280px;
    height: auto;
    border-radius: var(--radius);
    flex-shrink: 0;
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }
  .highlight-image:hover {
    opacity: 0.85;
  }
  @media (max-width: 768px) {
    .highlight-image {
      cursor: default;
    }
    .highlight-image:hover {
      opacity: 1;
    }
  }
  .highlight-image-caption {
    font-size: var(--font-size-xs, 0.8rem);
    font-style: italic;
    color: var(--color-muted);
    line-height: 1.35;
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid rgba(201, 168, 76, 0.25);
  }
  .highlight-text {
    display: flex;
    flex-direction: column;
  }
  .highlight-label {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }
  .highlight-title {
    font-size: var(--font-size-md);
    font-weight: 700;
    color: var(--color-gold);
    margin-bottom: 10px;
  }
  .highlight-caption {
    margin: 0;
    font-style: italic;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }
  @media (min-width: 769px) {
    .highlight-card {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      text-align: left;
      padding: 24px;
    }
    .highlight-image {
      max-width: 240px;
    }
  }

  /* --- Desktop: grid view --- */
  .gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }
  .gallery-item {
    margin: 0;
    flex: 0 1 220px;
    cursor: zoom-in;
  }
  .gallery-item img {
    border-radius: var(--radius);
    width: 100%;
    transition: opacity 0.2s ease;
  }
  .gallery-item:hover img {
    opacity: 0.85;
  }

  /* --- Mobile: slider --- */
  .gallery-slider {
    display: none;
  }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: var(--radius);
    object-fit: contain;
  }

  /* --- Mobile overrides --- */
  @media (max-width: 768px) {
    .gallery-grid {
      display: none;
    }
    .gallery-slider {
      display: block;
    }
    .slider-track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 12px;
    }
    .slider-track::-webkit-scrollbar {
      display: none;
    }
    .slider-slide {
      margin: 0;
      flex: 0 0 80%;
      scroll-snap-align: center;
    }
    .slider-slide img {
      border-radius: var(--radius);
      width: 100%;
    }
    .slider-dots {
      display: flex;
      justify-content: center;
      gap: 0;
      margin-top: 4px;
    }
    /* The button is the 24px touch target; the visible dot is drawn inside. */
    .slider-dot {
      width: 24px;
      height: 24px;
      border: none;
      background: transparent;
      padding: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .slider-dot::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1px solid var(--color-gold);
      transition: background 0.2s ease;
    }
    .slider-dot.is-active::before {
      background: var(--color-gold);
    }
    .slider-dot:focus-visible {
      outline: 2px solid var(--color-gold);
      outline-offset: -2px;
      border-radius: 50%;
    }
    .gallery-item {
      cursor: default;
    }
    .gallery-item:hover img {
      opacity: 1;
    }
  }
</style>

<script>
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Slider images after the first: `src` is set when the slide comes near
  // the visible part of the track, and only once its gallery is open: the
  // closed ones are folded to zero height, but an observer rooted on the
  // track would still see their slides.
  const lazyTracks = new WeakSet<HTMLElement>();
  const loadSlide = (img: HTMLImageElement) => {
    const src = img.dataset.src;
    if (src) {
      img.src = src;
      img.removeAttribute('data-src');
    }
  };

  const startLazy = (track: HTMLElement | null | undefined) => {
    if (!track || lazyTracks.has(track)) return;
    lazyTracks.add(track);
    const pending = track.querySelectorAll<HTMLImageElement>('img[data-src]');
    if (pending.length) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              loadSlide(entry.target as HTMLImageElement);
              io.unobserve(entry.target);
            });
          },
          { root: track, rootMargin: '0px 50% 0px 50%' },
        );
        pending.forEach((img) => io.observe(img));
      } else {
        pending.forEach(loadSlide);
      }
    }
  };

  // Accordion
  document.querySelectorAll<HTMLElement>('.gallery-header').forEach((btn) => {
    const track = btn.parentElement?.querySelector<HTMLElement>('.slider-track');
    if (btn.getAttribute('aria-expanded') === 'true') startLazy(track);
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (!expanded) startLazy(track);
    });
  });

  document.querySelectorAll<HTMLElement>('.slider-track').forEach((track) => {
    // Mobile slider dots
    const dots = track.parentElement?.querySelectorAll('.slider-dot');
    if (!dots || !dots.length) return;
    const slides = track.querySelectorAll<HTMLElement>('.slider-slide');
    const slideWidth = () => slides[0].offsetWidth + 12;

    let scrollTick = false;
    track.addEventListener(
      'scroll',
      () => {
        if (scrollTick) return;
        scrollTick = true;
        requestAnimationFrame(() => {
          const index = Math.round(track.scrollLeft / slideWidth());
          dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
          scrollTick = false;
        });
      },
      { passive: true },
    );

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        track.scrollTo({ left: i * slideWidth(), behavior: reduceMotion() ? 'auto' : 'smooth' });
      });
    });
  });

  // Lightbox (desktop only)
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  if (lightbox && lightboxImg) {
    const isMobile = () => window.innerWidth <= 768;
    const close = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
    };

    document.querySelectorAll<HTMLElement>('.gallery-item, .highlight-image').forEach((el) => {
      const img = el.tagName === 'IMG' ? (el as HTMLImageElement) : el.querySelector('img');
      if (!img) return;
      const open = () => {
        if (isMobile()) return;
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
      };
      el.addEventListener('click', open);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });

    lightbox.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
