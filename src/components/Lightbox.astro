---
/* Site-wide lightbox: opens any <a> linking to a photo (.webp/.jpg/.jpeg/.png/.avif/.gif)
   in an overlay instead of a new tab. Falls back to the original target on no-JS.
   Images in post and guide text (.prose) that are not links already get one at
   load, to their largest srcset candidate, so they open zoomed too.
   Inside a [data-gallery] (an event's album) the photos form a sequence:
   arrow buttons, the ←/→ keys and a swipe move through them. */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<div
  class="lightbox"
  id="app-lightbox"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label={t.lightbox.label}
  data-open-label={t.lightbox.open}
  inert
>
  <button type="button" class="lightbox-close" id="app-lightbox-close" aria-label={t.lightbox.close}>
    ×
  </button>
  <img class="lightbox-img" id="app-lightbox-img" alt="" />
  <button type="button" class="lightbox-nav lightbox-prev" id="app-lightbox-prev" aria-label={t.lightbox.prev} hidden>
    ‹
  </button>
  <button type="button" class="lightbox-nav lightbox-next" id="app-lightbox-next" aria-label={t.lightbox.next} hidden>
    ›
  </button>
  <p class="lightbox-count" id="app-lightbox-count" aria-live="polite" hidden></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    padding: 24px;
  }
  .lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    cursor: zoom-out;
  }
  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 20px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 32px;
    line-height: 1;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    background: rgba(255, 255, 255, 0.18);
    outline: none;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .lightbox-nav[hidden],
  .lightbox-count[hidden] {
    display: none;
  }
  .lightbox-prev {
    left: 16px;
  }
  .lightbox-next {
    right: 16px;
  }
  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    background: rgba(255, 255, 255, 0.18);
    outline: none;
  }
  .lightbox-count {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 30px;
    }
    .lightbox-prev {
      left: 8px;
    }
    .lightbox-next {
      right: 8px;
    }
  }
  /* Zoom links around images, here and from Zoomable.astro */
  :global(a.zoomable) {
    cursor: zoom-in;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  const lb = document.getElementById('app-lightbox');
  const img = document.getElementById('app-lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('app-lightbox-close');
  const prevBtn = document.getElementById('app-lightbox-prev');
  const nextBtn = document.getElementById('app-lightbox-next');
  const count = document.getElementById('app-lightbox-count');

  if (lb && img && closeBtn && prevBtn && nextBtn && count) {
    const PHOTO_RE = /\.(webp|jpe?g|png|avif|gif)(\?.*)?(#.*)?$/i;
    // The link that opened the photo, to give focus back on close.
    let opener: HTMLElement | null = null;
    // The photo links of the [data-gallery] the open photo belongs to, if any.
    let group: HTMLAnchorElement[] = [];
    let current = 0;

    const isPhoto = (a: HTMLAnchorElement) => PHOTO_RE.test(a.getAttribute('href') || '');
    const show = (i: number) => {
      current = (i + group.length) % group.length;
      const a = group[current];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt || '';
      count.textContent = `${current + 1} / ${group.length}`;
      // Warm the next photo so the arrow feels instant.
      new Image().src = group[(current + 1) % group.length].href;
    };

    const open = (href: string, alt: string, from: HTMLElement) => {
      opener = from;
      const gallery = from.closest<HTMLElement>('[data-gallery]');
      group = gallery ? [...gallery.querySelectorAll<HTMLAnchorElement>('a[href]')].filter(isPhoto) : [];
      const many = group.length > 1;
      prevBtn.hidden = nextBtn.hidden = count.hidden = !many;
      if (many) show(Math.max(0, group.indexOf(from as HTMLAnchorElement)));
      else {
        img.src = href;
        img.alt = alt || '';
      }
      lb.classList.add('is-open');
      lb.setAttribute('aria-hidden', 'false');
      lb.inert = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };
    const close = () => {
      if (!lb.classList.contains('is-open')) return;
      lb.classList.remove('is-open');
      lb.setAttribute('aria-hidden', 'true');
      lb.inert = true;
      img.removeAttribute('src');
      document.body.style.overflow = '';
      // Back to the link of the photo last shown, so the page follows the browsing.
      (group.length > 1 ? group[current] : opener)?.focus();
      opener = null;
      group = [];
    };

    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a');
      if (!a) return;
      if (a.dataset.noLightbox !== undefined) return;
      const href = a.getAttribute('href');
      if (!href || !PHOTO_RE.test(href)) return;
      // Skip modifier-clicks so users can still open in new tab on purpose.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      const innerImg = a.querySelector('img');
      open(href, innerImg ? innerImg.alt : '', a);
    });

    // Body images of the markdown: wrap the bare ones in a link to the full file.
    const largest = (el: HTMLImageElement) => {
      const set = (el.getAttribute('srcset') || '')
        .split(',')
        .map((c) => c.trim().split(/\s+/)[0])
        .filter(Boolean);
      return set[set.length - 1] || el.getAttribute('src') || '';
    };
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((el) => {
      if (el.closest('a, .card-hover')) return;
      const href = largest(el);
      if (!PHOTO_RE.test(href)) return;
      const a = document.createElement('a');
      a.href = href;
      a.className = 'zoomable';
      a.setAttribute('aria-label', `${lb.dataset.openLabel || ''}: ${el.alt}`);
      el.replaceWith(a);
      a.appendChild(el);
    });

    lb.addEventListener('click', (e) => {
      if (e.target === img || e.target === prevBtn || e.target === nextBtn) return;
      close();
    });
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    // A one-finger swipe moves through a gallery; a pinch, or panning a zoomed-in photo, does not.
    let startX = 0;
    let multiTouch = false;
    lb.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length > 1) multiTouch = true;
        else startX = e.touches[0].clientX;
      },
      { passive: true },
    );
    lb.addEventListener('touchend', (e) => {
      const pinched = multiTouch;
      if (e.touches.length === 0) multiTouch = false;
      if (group.length < 2 || pinched || e.touches.length > 0 || (window.visualViewport?.scale ?? 1) > 1) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (group.length > 1 && e.key === 'ArrowLeft') show(current - 1);
      else if (group.length > 1 && e.key === 'ArrowRight') show(current + 1);
      // Keep focus on the overlay controls: close, and the arrows of a gallery.
      if (e.key === 'Tab') {
        e.preventDefault();
        const controls = [closeBtn, prevBtn, nextBtn].filter((b) => !b.hidden);
        const at = controls.indexOf(document.activeElement as HTMLElement);
        controls[(at + (e.shiftKey ? -1 : 1) + controls.length) % controls.length].focus();
      }
    });
  }
</script>
