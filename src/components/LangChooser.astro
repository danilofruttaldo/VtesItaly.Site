---
/**
 * Language chooser popup, shown on first visit when no preference is saved.
 * Redirect logic lives in Base.astro <head> for instant redirect without flash.
 */
import { getLocaleFromUrl, getAlternateUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const altUrl = getAlternateUrl(Astro.url, locale === 'it' ? 'en' : 'it');
---

<div class="lang-chooser-overlay" id="lang-chooser" aria-hidden="true">
  <div class="lang-chooser" role="dialog" aria-modal="true" aria-label={t.nav.choose_language} tabindex="-1">
    <div class="lang-chooser__options">
      <button
        class="lang-chooser__btn"
        type="button"
        data-lang="it"
        data-href={locale === 'it' ? '' : altUrl}
        aria-label="IT, Italiano"
        lang="it"
      >
        <svg class="flag-icon" viewBox="0 0 640 480">
          <path fill="#009246" d="M0 0h213.3v480H0z"></path>
          <path fill="#fff" d="M213.3 0h213.4v480H213.3z"></path>
          <path fill="#ce2b37" d="M426.7 0H640v480H426.7z"></path>
        </svg>
        IT
      </button>
      <button
        class="lang-chooser__btn"
        type="button"
        data-lang="en"
        data-href={locale === 'en' ? '' : altUrl}
        aria-label="EN, English"
        lang="en"
      >
        <svg class="flag-icon" viewBox="0 0 640 480">
          <path fill="#012169" d="M0 0h640v480H0z"></path>
          <path
            fill="#FFF"
            d="m75 0 244 181L562 0h78v62L400 241l240 178v61h-80L320 301 81 480H0v-60l239-178L0 64V0h75z"
          ></path>
          <path
            fill="#C8102E"
            d="m424 281 216 159v40L369 281h55zm-184 20 6 35L54 480H0l240-179zM640 0v3L391 191l2-44L590 0h50zM0 0l239 176h-60L0 42V0z"
          ></path>
          <path fill="#FFF" d="M241 0v480h160V0H241zM0 160v160h640V160H0z"></path>
          <path fill="#C8102E" d="M0 193v96h640v-96H0zM273 0v480h96V0h-96z"></path>
        </svg>
        EN
      </button>
    </div>
  </div>
</div>

<style is:global>
  .lang-chooser-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    justify-content: center;
    align-items: center;
  }

  .lang-chooser-overlay.is-open {
    display: flex;
  }

  .lang-chooser {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 32px 40px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    max-width: 360px;
    width: 90vw;
    animation: lang-chooser-in 0.2s ease;
  }

  @keyframes lang-chooser-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lang-chooser__options {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .lang-chooser__btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-contrast);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .lang-chooser__btn:hover,
  .lang-chooser__btn:focus-visible {
    background-color: var(--color-accent-light);
    border-color: var(--color-accent-1);
  }

  .lang-chooser__btn:focus-visible {
    outline: 2px solid var(--color-accent-1);
    outline-offset: 2px;
  }

  .lang-chooser__btn .flag-icon {
    width: 22px;
    height: 16px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-chooser {
      animation: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'vtesitaly-lang';
  let saved: string | null = null;
  try {
    saved = localStorage.getItem(STORAGE_KEY);
  } catch {
    /* storage unavailable */
  }

  const overlay = document.getElementById('lang-chooser');
  // If preference already saved, do nothing (redirect handled in <head>)
  if (!saved && overlay) {
    const ov = overlay;
    ov.classList.add('is-open');
    ov.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    const buttons = Array.from(ov.querySelectorAll<HTMLButtonElement>('.lang-chooser__btn'));
    // Focus first interactive button for keyboard/screen-reader users
    buttons[0]?.focus();

    // Focus trap between the two buttons
    ov.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        (document.activeElement === buttons[0] ? buttons[1] : buttons[0])?.focus();
      }
    });

    const choose = (btn: HTMLButtonElement) => {
      try {
        localStorage.setItem(STORAGE_KEY, btn.dataset.lang || '');
      } catch {
        /* storage unavailable */
      }
      ov.classList.remove('is-open');
      ov.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      const href = btn.dataset.href;
      if (href && href !== location.pathname) location.replace(href);
    };

    buttons.forEach((btn) => btn.addEventListener('click', () => choose(btn)));
  }
</script>
