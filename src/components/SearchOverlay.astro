---
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div
  class="vtesitaly-search-overlay"
  id="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-label={t.search.dialog_label}
  aria-hidden="true"
  inert
>
  <button type="button" class="vtesitaly-search-close" aria-label={t.search.close_label}>
    &times;
  </button>
  <div class="vtesitaly-search-container">
    <input
      type="search"
      id="pagefind-input"
      class="vtesitaly-search-field"
      placeholder={t.search.placeholder}
      aria-label={t.search.aria_label}
      autocomplete="off"
    />
    <div
      id="pagefind-results"
      class="vtesitaly-search-results"
      data-no-results={t.search.no_results}
      aria-live="polite"
    ></div>
  </div>
</div>

<script>
  import { excerptSegments } from '../utils/search-excerpt';

  type PagefindResult = { url: string; excerpt: string; meta: { title: string } };
  type Pagefind = {
    init: () => Promise<void>;
    search: (q: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }>;
  };

  const overlay = document.getElementById('search-overlay');
  const closeBtn = overlay?.querySelector<HTMLButtonElement>('.vtesitaly-search-close');
  const input = document.getElementById('pagefind-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('pagefind-results');

  if (overlay && closeBtn && input && resultsContainer) {
    const box = overlay;
    const field = input;
    const results = resultsContainer;
    let pagefind: Pagefind | null = null;
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    // Every query gets a number; an answer that arrives after a newer query
    // started is dropped, so slow results never overwrite fresher ones.
    let searchSeq = 0;
    let opener: HTMLElement | null = null;
    let pagefindWarned = false;

    const initPagefind = async () => {
      if (pagefind) return;
      try {
        // Built by `pagefind --site dist` after astro: not a module Vite can see.
        const path = '/pagefind/pagefind.js';
        pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
        await pagefind.init();
      } catch (err) {
        // In sviluppo l'indice non c'e' (lo crea `pagefind` dopo la build); in
        // produzione e' un guasto vero (indice mancante, rete, CSP). In tutti e
        // due i casi resta nella console (una volta sola: il caricamento si
        // ritenta a ogni ricerca), e la ricerca semplicemente non mostra
        // risultati.
        if (!pagefindWarned) console.warn('Ricerca: Pagefind non disponibile.', err);
        pagefindWarned = true;
      }
    };

    const render = (items: PagefindResult[]) => {
      results.textContent = '';
      if (items.length === 0) {
        const noRes = document.createElement('p');
        noRes.className = 'search-no-results';
        noRes.textContent = results.getAttribute('data-no-results') || '';
        results.appendChild(noRes);
        return;
      }
      items.forEach((r) => {
        const a = document.createElement('a');
        a.href = r.url;
        a.className = 'search-result';

        const title = document.createElement('span');
        title.className = 'search-result__title';
        title.textContent = r.meta.title;
        a.appendChild(title);

        const excerpt = document.createElement('span');
        excerpt.className = 'search-result__excerpt';
        excerptSegments(r.excerpt).forEach((seg) => {
          if (seg.kind === 'text') {
            excerpt.appendChild(document.createTextNode(seg.value));
          } else {
            const mark = document.createElement('mark');
            mark.textContent = seg.value;
            excerpt.appendChild(mark);
          }
        });
        a.appendChild(excerpt);
        results.appendChild(a);
      });
    };

    const doSearch = async (query: string) => {
      const seq = ++searchSeq;
      if (!query || query.length < 2) {
        results.textContent = '';
        return;
      }
      await initPagefind();
      if (!pagefind || seq !== searchSeq) return;
      const search = await pagefind.search(query);
      const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      if (seq !== searchSeq) return;
      render(items);
    };

    const isOpen = () => box.classList.contains('open');

    const openOverlay = (e: Event) => {
      const detail = (e as CustomEvent<{ opener?: HTMLElement }>).detail;
      opener = detail?.opener ?? (document.activeElement as HTMLElement | null);
      box.inert = false;
      box.setAttribute('aria-hidden', 'false');
      box.classList.add('open');
      initPagefind();
      field.value = '';
      results.textContent = '';
      searchSeq++;
      // Visibility flips at once (see the CSS); the frame lets the browser
      // apply it before the focus moves.
      requestAnimationFrame(() => field.focus());
    };

    const closeOverlay = () => {
      if (!isOpen()) return;
      searchSeq++;
      clearTimeout(debounceTimer);
      box.classList.remove('open');
      box.setAttribute('aria-hidden', 'true');
      box.inert = true;
      opener?.focus();
      opener = null;
    };

    document.addEventListener('open-search', openOverlay);
    closeBtn.addEventListener('click', closeOverlay);
    box.addEventListener('click', (e) => {
      if (e.target === box) closeOverlay();
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        closeOverlay();
        return;
      }
      // Focus trap: Tab cycles between the input, the results and the close button.
      if (e.key === 'Tab') {
        const focusable = Array.from(box.querySelectorAll<HTMLElement>('button, input, a[href]'));
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey && (active === first || !box.contains(active))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !box.contains(active))) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    field.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = field.value.trim();
      debounceTimer = setTimeout(() => doSearch(query), 200);
    });
  }
</script>

<style>
  .vtesitaly-search-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    background-color: rgba(18, 20, 22, 0.95);
    opacity: 0;
    visibility: hidden;
    /* On close, visibility waits for the fade-out to end. */
    transition:
      opacity 0.2s ease,
      visibility 0s linear 0.2s;
    overflow-y: auto;
  }

  .vtesitaly-search-overlay:global(.open) {
    opacity: 1;
    visibility: visible;
    /* On open, visibility flips at once so the input can take focus. */
    transition:
      opacity 0.2s ease,
      visibility 0s;
  }

  .vtesitaly-search-close {
    position: absolute;
    top: 20px;
    right: 24px;
    font-size: 2rem;
    color: var(--color-muted);
    background: none;
    border: none;
    cursor: pointer;
    line-height: var(--leading-none);
  }

  .vtesitaly-search-close:hover {
    color: var(--color-contrast);
  }

  .vtesitaly-search-container {
    width: 100%;
    max-width: 600px;
    padding-inline: clamp(12px, 4vw, var(--spacing-md));
  }

  .vtesitaly-search-field {
    width: 100%;
    padding: 14px 20px;
    font-size: var(--font-size-md);
    font-family: var(--font-family);
    color: var(--color-contrast);
    background-color: var(--color-surface);
    border: 1px solid var(--color-accent-light);
    border-radius: var(--radius);
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition:
      border-color 0.2s ease,
      outline-color 0.2s ease;
  }

  .vtesitaly-search-field:focus {
    border-color: var(--color-gold);
    outline-color: var(--color-gold);
  }

  .vtesitaly-search-field::placeholder {
    color: var(--color-muted);
  }

  .vtesitaly-search-results {
    margin-top: var(--spacing-md);
  }

  .vtesitaly-search-results :global(.search-result) {
    display: block;
    padding: 14px 16px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-contrast);
    transition: background-color 0.15s ease;
  }

  .vtesitaly-search-results :global(.search-result:hover) {
    background-color: rgba(255, 255, 255, 0.06);
  }

  .vtesitaly-search-results :global(.search-result + .search-result) {
    border-top: 1px solid var(--color-border);
  }

  .vtesitaly-search-results :global(.search-result__title) {
    display: block;
    font-weight: 600;
    font-size: var(--font-size-small);
    color: var(--color-accent-1);
    margin-bottom: 4px;
  }

  .vtesitaly-search-results :global(.search-result__excerpt) {
    display: block;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  .vtesitaly-search-results :global(.search-result__excerpt mark) {
    background-color: transparent;
    color: var(--color-gold);
    font-weight: 600;
  }

  .vtesitaly-search-results :global(.search-no-results) {
    text-align: center;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: var(--spacing-md);
  }
</style>
