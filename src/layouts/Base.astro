---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Lightbox from '../components/Lightbox.astro';
import JsonLd from '../components/JsonLd.astro';
import LangChooser from '../components/LangChooser.astro';
import { getLocaleFromUrl, getAlternateUrl, useTranslations, getOtherLocales, DEFAULT_LOCALE } from '../utils/i18n';
import { ogImage as resolveOgImage } from '../utils/og';
import { isoDate } from '../utils/date';
// Classic inline script, run before the body is parsed so a saved language
// preference redirects without showing the wrong page first. It is the only
// inline script left: Astro does not hash `is:inline` scripts, so its sha256
// is computed from this same file in astro.config.mjs and added to the CSP.
// Its content must stay static: the per-page target travels in `data-alt`.
import langRedirectScript from '../scripts/lang-redirect.inline.js?raw';
// `?url` gives the hashed address Vite assigns to the file: the same one the
// @font-face in global.css points to, so the preload and the rule share a
// single download.
import manropeLatin from '../assets/fonts/manrope-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Service pages (404, pagination): no indexing, and no canonical/hreflang. */
  noindex?: boolean;
  /** `article` for dated content (posts), `website` for indexes. */
  ogType?: 'website' | 'article';
  /** Publication date, used only when `ogType` is `article`. */
  publishedTime?: Date;
  /** Early redirect to the saved language. Off on the 404, whose URL is not its own. */
  langRedirect?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const {
  title,
  description = t.default_description,
  ogImage = '/images/og/og-default.jpg',
  noindex = false,
  ogType = 'website',
  publishedTime,
  langRedirect = true,
} = Astro.props;
const otherLocales = getOtherLocales(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const alternates = otherLocales.map((alt) => ({
  locale: alt,
  href: new URL(getAlternateUrl(Astro.url, alt), Astro.site).href,
}));
// x-default is the Italian page, whichever language this one is.
const xDefault =
  locale === DEFAULT_LOCALE ? canonicalUrl.href : alternates.find((a) => a.locale === DEFAULT_LOCALE)!.href;
const altUrlForRedirect = getAlternateUrl(Astro.url, otherLocales[0]);
const og = await resolveOgImage(ogImage, Astro.site!);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/*
      The Content-Security-Policy is written by Astro (security.csp in
      astro.config.mjs) as a meta tag, with the sha256 of every script it
      emits. `frame-ancestors` is not there: meta-tag CSP does not honour it.
      Clickjacking protection must come from a server-side header in
      .htaccess.
    */}

    <title>{title} | VTES Italy</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl.href} />
        <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.locale} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | VTES Italy`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalUrl.href} />}
    <meta property="og:locale" content={t.og_locale} />
    <meta property="og:site_name" content="VTES Italy" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={isoDate(publishedTime)} />
    )}
    <meta property="og:image" content={og.url} />
    {og.type && <meta property="og:image:type" content={og.type} />}
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={`${title} | VTES Italy`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | VTES Italy`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />
    <meta name="twitter:image:alt" content={`${title} | VTES Italy`} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#121416" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Font preload (eliminates discovery delay) -->
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'VTES Italy',
        url: Astro.site?.href,
        logo: new URL('/images/logo.webp', Astro.site).href,
        description: t.default_description,
        sameAs: [
          'https://www.facebook.com/groups/115874240013',
          'https://www.instagram.com/vtes.italy',
          'https://www.youtube.com/@VtesItaly',
          'https://t.me/+i_YymbZgFS84YzRk',
        ],
      }}
    />
    <slot name="head" />
    {langRedirect && <script is:inline data-alt={altUrlForRedirect} set:html={langRedirectScript} />}
  </head>
  <body data-sw-title={t.sw_update.title} data-sw-reload={t.sw_update.reload} data-sw-dismiss={t.sw_update.dismiss}>
    <noscript>
      <p style="text-align:center;padding:1em;color:#9b9b9b;">{t.noscript}</p>
    </noscript>
    <a href="#main-content" class="sr-only">
      {t.skip_to_content}
    </a>
    <Header />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
    <LangChooser />
    <Lightbox />
    <button
      type="button"
      id="back-to-top"
      class="back-to-top"
      aria-label={t.post.back_to_top}
      title={t.post.back_to_top}
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script>
      // One bundled module for the whole layout: no inline code, so the CSP
      // needs no 'unsafe-inline' for scripts.
      import '../scripts/sw-register';
      import '../scripts/back-to-top';
      import '../scripts/temporal';
      import '../scripts/matomo';
    </script>
  </body>
</html>
