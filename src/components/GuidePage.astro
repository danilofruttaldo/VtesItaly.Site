---
import { contentGitDates } from '../utils/git-dates';
import { isoDate } from '../utils/date';
import '../styles/prose.css';
import '../styles/guide.css';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from './JsonLd.astro';
import ShareButtons from './ShareButtons.astro';
import GuideCard from './guide/GuideCard.astro';
import Toc from './guide/Toc.astro';
import { getCollection, render } from 'astro:content';
import { filterByLocale, useTranslations, formatLocalDate, translateSection, type Locale } from '../utils/i18n';

interface Props {
  guide: CollectionEntry<'guide'>;
  locale: Locale;
}

const { guide, locale } = Astro.props;
const t = useTranslations(locale);
const { Content, headings } = await render(guide);

const audienceLabel: Record<string, string> = {
  giocatore: t.guide.audience_giocatore,
  principe: t.guide.audience_principe,
  judge: t.guide.audience_judge,
  nuovi: t.guide.audience_nuovi,
};

// EN guides are `<slug>-en` files served at the bare slug.
const urlSlug = (g: CollectionEntry<'guide'>) => g.id.replace(/-en$/, '');
const cleanSlug = urlSlug(guide);

// Resolve related guides (`correlate` lists the bare slugs)
const allGuides = filterByLocale(await getCollection('guide'), locale);
const related = (guide.data.correlate ?? [])
  .map((slug) => allGuides.find((g) => g.id === slug || urlSlug(g) === slug))
  .filter((g): g is (typeof allGuides)[number] => !!g);
// GuideCard adds the locale prefix itself.
const guideSection = translateSection('guide', locale);

// "Report an issue": GitHub issue prefilled
const issueText = {
  it: { label: 'guida', page: 'Pagina', body: 'Descrivi qui il problema riscontrato.' },
  en: { label: 'guide', page: 'Page', body: 'Describe the issue here.' },
}[locale];
const issueTitle = encodeURIComponent(`[${issueText.label}] ${cleanSlug}`);
const issueBody = encodeURIComponent(
  `${issueText.page}: ${Astro.site?.href ?? ''}${t.routes.guide.slice(1)}${cleanSlug}/\n\n${issueText.body}`,
);
const issueUrl = `https://github.com/danilofruttaldo/VtesItaly.Site/issues/new?title=${issueTitle}&body=${issueBody}&labels=${issueText.label}`;
const guideUpdated = isoDate(guide.data.aggiornato);
const guideCreated = guide.filePath ? contentGitDates().get(guide.filePath)?.created : undefined;
const guidePublished = guideCreated && guideCreated < guideUpdated ? guideCreated : guideUpdated;
---

<Base title={guide.data.title} description={guide.data.description}>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: guide.data.title,
      description: guide.data.description,
      // Published: first commit of the guide; modified: its curated `aggiornato`.
      datePublished: guidePublished,
      dateModified: isoDate(guide.data.aggiornato),
      inLanguage: locale,
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, Astro.site).href },
      image: new URL('/images/og/og-default.jpg', Astro.site).href,
      ...(guide.data.versione ? { version: guide.data.versione } : {}),
      author: { '@type': 'Organization', name: 'VTES Italy' },
      publisher: {
        '@type': 'Organization',
        name: 'VTES Italy',
        logo: { '@type': 'ImageObject', url: new URL('/images/logo.webp', Astro.site).href },
      },
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(t.routes.home, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: t.page_titles.Guide, item: new URL(t.routes.guide, Astro.site).href },
        {
          '@type': 'ListItem',
          position: 3,
          name: guide.data.title,
          item: new URL(Astro.url.pathname, Astro.site).href,
        },
      ],
    }}
  />

  <article class="guide-page">
    <div class="container">
      <a href={t.routes.guide} class="guide-page__back">
        &larr; {t.guide.back_to_index}
      </a>

      <header class="guide-page__header">
        <h1 class="guide-page__title">{guide.data.title}</h1>
        <div class="guide-page__audience">
          {guide.data.audience.map((a) => (
            <span class={`guide-badge guide-badge--${a}`}>{audienceLabel[a]}</span>
          ))}
        </div>
        <div class="guide-page__meta">
          {guide.data.versione && (
            <span class="guide-page__meta-version">
              {t.guide.version_prefix}
              {guide.data.versione} &middot;
            </span>
          )}
          <span>
            {t.guide.updated_on}{' '}
            <time datetime={guide.data.aggiornato.toISOString()}>{formatLocalDate(guide.data.aggiornato, locale)}</time>
          </span>
        </div>
      </header>

      <hr class="guide-page__divider" />

      <div class="guide-layout">
        <aside>
          <Toc headings={headings} locale={locale} />
        </aside>

        <div class="guide-content prose">
          <Content />

          {related.length > 0 && (
            <section class="guide-related">
              <h2 class="guide-related__title">{t.guide.see_also}</h2>
              <div class="guide-related__grid">
                {related.map((g) => (
                  <GuideCard
                    href={`/${guideSection}/${urlSlug(g)}/`}
                    title={g.data.title}
                    description={g.data.description}
                    audience={g.data.audience}
                    aggiornato={g.data.aggiornato}
                    locale={locale}
                  />
                ))}
              </div>
            </section>
          )}

          <p class="guide-report">
            <a href={issueUrl} target="_blank" rel="noopener noreferrer">
              {t.guide.report_issue}
            </a>
          </p>
        </div>
      </div>

      <ShareButtons />
    </div>
  </article>
</Base>
