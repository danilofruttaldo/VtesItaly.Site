---
import { loadStandings } from '../utils/standings';
import { isoDay } from '../utils/date';
import '../styles/prose.css';
import '../styles/tour-edition.css';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../utils/i18n';
import { useTranslations, formatLocalDate } from '../utils/i18n';
import {
  resolvePlatformLabel,
  computeStageDisplayImages,
  stagePlaceholder,
  stageStatusesOn,
  tourIsOver,
} from '../utils/status';
import { imageFocus, responsiveImage } from '../utils/image';
import Zoomable from './Zoomable.astro';
import { anonymizeName } from '../utils/anonymize';
import { cities } from '../data/cities';
import { todayLocalIso } from '../utils/today';
import { albumFor } from '../utils/albums';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
}

const { post, locale = 'it' } = Astro.props;
if (post.data.category !== 'tour') {
  throw new Error(`TourEdition: unsupported category "${post.data.category}"`);
}
const t = useTranslations(locale);
const cityMap = new Map(
  cities.map((c) => [
    c.slug.it,
    {
      name: c.name[locale],
      url: locale === 'en' ? `/en/domains/${c.slug.en}/` : `/principati/${c.slug.it}/`,
    },
  ]),
);
const stagesLabel = post.data.stagesLabel || t.tour.stages_label;
const stageItemLabel = post.data.stageItemLabel || t.tour.stage_item;
const { Content } = await render(post);
const stages = post.data.stages || [];

const displayImages = computeStageDisplayImages(stages);
const placeholderImage = stagePlaceholder(stages);
// Width variants of the covers (scripts/build-poster-variants.mjs): the cards
// are 220 px wide, full width on phones.
const STAGE_SIZES = '(max-width: 640px) 100vw, 220px';
const stageSrcset = (image: string | undefined) => responsiveImage(image).srcset;
// The square card crops the stage cover in CSS: keep its point of interest in view.
const stagePosition = (image: string | undefined) => {
  const p = imageFocus(image);
  return p ? `object-position: ${p}` : undefined;
};
const stageStates = stages.map((s) => ({
  date: isoDay(s.date),
  cancelled: !!s.cancelled,
  hidden: !!s.hideDate,
}));
const stageStatuses = stageStatusesOn(stageStates, todayLocalIso());
const computedStages = stages.map((s, i) => ({ ...s, dateIso: stageStates[i].date, status: stageStatuses[i] }));
// Shareable anchors: one per stage (/tour/#tappa-6) and one that always lands on
// the upcoming stage (/tour/#prossima), moved client-side as the days go by.
const stageAnchor = (i: number) => `${locale === 'en' ? 'stage' : 'tappa'}-${i + 1}`;
const nextAnchor = locale === 'en' ? 'next' : 'prossima';
const nextStageIndex = stageStatuses.indexOf('upcoming');

const statusLabels: Record<string, string> = {
  completed: t.tour.status_completed,
  upcoming: t.tour.status_upcoming,
  future: t.tour.status_future,
  cancelled: t.tour.status_cancelled,
};

function formatDate(date: Date): string {
  if (date.getDate() === 1) {
    return formatLocalDate(date, locale, { month: 'long', year: 'numeric' });
  }
  return formatLocalDate(date, locale);
}

// Load tour standings
interface TourStanding {
  rank: number;
  name: string;
  city: string;
  total: number;
  [key: string]: number | string | null;
}
const tourStandings = loadStandings<TourStanding>(post.data.standingsUrl);
const stageCount = tourStandings.length > 0 ? stages.length : 0;
const hasGw = tourStandings.some((s) => (s as any).gw != null);
const tourFinished = tourIsOver(stageStatuses);

function formatStage(val: unknown, isAway: boolean): string {
  if (val == null) return '-';
  const suffix = isAway ? '*' : '';
  if (typeof val === 'object' && val !== null && 'gw' in val && 'vp' in val) {
    return `${(val as any).gw}GW ${(val as any).vp}${suffix}`;
  }
  return `${val}${suffix}`;
}
---

<div class="tour-edition">
  {(tourStandings.length > 0 || nextStageIndex !== -1) && (
    <nav class="te-quicknav">
      {/* Only while a stage is ahead: once the tour is over none ever comes back */}
      {nextStageIndex !== -1 && (
        <a href={`#${nextAnchor}`} class="te-quicknav-link te-quicknav-next">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
          {t.post.jump_next_stage}
        </a>
      )}
      {tourStandings.length > 0 && (
        <a href="#classifica" class="te-quicknav-link">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
          {t.post.jump_standings}
        </a>
      )}
    </nav>
  )}

  <div class="te-content prose">
    <Content />
  </div>

  {post.data.rulesUrl && (
    <div class="te-rules">
      <a href={post.data.rulesUrl} target="_blank" rel="noopener noreferrer" class="te-rules-link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <>
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </>
        </svg>
        {t.tour.rules} (PDF)
      </a>
    </div>
  )}

  {computedStages.length > 0 && (
    <div class="te-stages">
      <h2 class="te-stages-title">{stagesLabel}</h2>
      <div class="te-stages-list">
        {computedStages.map((stage, i) => (
          <div
            id={stageAnchor(i)}
            class:list={[
              'te-card',
              {
                'te-card--upcoming': stage.status === 'upcoming',
                'te-card--completed': stage.status === 'completed',
                'te-card--cancelled': stage.status === 'cancelled',
                'te-card--clickable': !!stage.archonUrl,
              },
            ]}
            data-href={stage.archonUrl || undefined}
            data-stage-date={stage.dateIso}
            data-stage-cancelled={stage.status === 'cancelled' ? 'true' : undefined}
            data-stage-hidden-date={stage.hideDate ? 'true' : undefined}
          >
            {i === nextStageIndex && <span id={nextAnchor} class="te-next-anchor" />}
            {stage.image && (
              <Zoomable href={displayImages[i]} alt={stage.name} class="te-card-image">
                <img
                  src={displayImages[i]}
                  srcset={stageSrcset(displayImages[i])}
                  sizes={STAGE_SIZES}
                  alt={stage.name}
                  loading="lazy"
                  decoding="async"
                  style={stagePosition(displayImages[i])}
                  data-real-image={stage.image}
                  data-real-srcset={stageSrcset(stage.image)}
                  data-real-position={imageFocus(stage.image)}
                  data-placeholder-srcset={stageSrcset(placeholderImage)}
                  data-placeholder-position={imageFocus(placeholderImage)}
                />
              </Zoomable>
            )}
            <div class="te-card-body">
              <div class="te-card-top">
                <div class="te-card-heading">
                  <span class="te-number">
                    {stageItemLabel} {i + 1}
                  </span>
                  <h3 class="te-name">{stage.name}</h3>
                </div>
                <span
                  class:list={['te-badge', `te-badge--${stage.status}`]}
                  data-label-completed={statusLabels.completed}
                  data-label-upcoming={statusLabels.upcoming}
                  data-label-future={statusLabels.future}
                  data-label-cancelled={statusLabels.cancelled}
                >
                  {statusLabels[stage.status]}
                </span>
              </div>
              {stage.cities && stage.cities.length > 0 && (
                <div class="te-cities">
                  {stage.cities.map((c) => {
                    const city = cityMap.get(c);
                    return city ? (
                      <a href={city.url} class="te-city-tag">
                        {city.name}
                      </a>
                    ) : (
                      <span class="te-city-tag">{c}</span>
                    );
                  })}
                </div>
              )}
              {stage.description && <p class="te-desc">{stage.description}</p>}
              <div class="te-card-bottom">
                <div class="te-meta">
                  {!stage.hideDate && (
                    <div class="te-date">
                      <svg
                        viewBox="0 0 24 24"
                        width="14"
                        height="14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                      </svg>
                      <time>{formatDate(stage.date)}</time>
                    </div>
                  )}
                  {stage.time && (
                    <div class="te-time">
                      <svg
                        viewBox="0 0 24 24"
                        width="14"
                        height="14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                      {stage.time}
                    </div>
                  )}
                  {(stage.venue || stage.location) && (
                    <div class="te-venue-block">
                      <div class="te-venue-name">
                        <svg
                          viewBox="0 0 24 24"
                          width="14"
                          height="14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                          <circle cx="12" cy="10" r="3" />
                        </svg>
                        {stage.venue || stage.location}
                      </div>
                      {stage.venue && stage.location && <div class="te-venue-address">{stage.location}</div>}
                    </div>
                  )}
                </div>
                <div class="te-actions">
                  {stage.archonUrl ? (
                    <a
                      href={stage.archonUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={['te-cta', `te-cta--${stage.status}`]}
                    >
                      {resolvePlatformLabel(stage.archonUrl)} &rarr;
                    </a>
                  ) : (
                    <span class="te-cta te-cta--soon">{t.tour.coming_soon}</span>
                  )}
                  {stage.album && albumFor(stage.album) && (
                    <a href={albumFor(stage.album)!.url} class="te-photos">
                      {t.tour.stage_photos} ({albumFor(stage.album)!.photos.length}) &rarr;
                    </a>
                  )}
                  {stage.videos && (
                    <a href={stage.videos} target="_blank" rel="noopener noreferrer" class="te-photos">
                      {t.tour.stage_videos} &rarr;
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {tourStandings.length > 0 && (
    <div id="classifica" class="te-standings">
      <h2 class="te-standings-title">{t.tour.standings}</h2>
      <div class="te-standings-wrap" tabindex="0" role="region" aria-label={t.tour.standings}>
        <table class="te-standings-table">
          <caption class="sr-only">{t.tour.standings}</caption>
          <thead>
            <tr>
              <th class="tc">#</th>
              <th>{t.tour.standings_player}</th>
              <th>{t.tour.standings_city}</th>
              {Array.from({ length: stageCount }, (_, i) => (
                <th class="tc">{`${stageItemLabel[0]}${i + 1}`}</th>
              ))}
              <th class="tc">TOT</th>
            </tr>
          </thead>
          <tbody>
            {tourStandings.map((s) => (
              <tr
                data-rank={s.rank}
                class:list={[
                  tourFinished && s.rank <= 1 && 'te-standings-winner',
                  tourFinished && s.rank >= 2 && s.rank <= 3 && 'te-standings-top',
                ]}
              >
                <td class="tc">{s.rank}</td>
                <td>{anonymizeName(s.name)}</td>
                <td class="te-standings-city">{s.city}</td>
                {Array.from({ length: stageCount }, (_, i) => (
                  <td class:list={['tc', s[`s${i + 1}`] == null && 'te-standings-empty']}>
                    {formatStage(s[`s${i + 1}`], (s as any).away?.includes(i + 1))}
                  </td>
                ))}
                <td class="tc te-standings-total">{hasGw ? `${(s as any).gw}GW ${s.total}` : s.total}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {tourStandings.some((s) => (s as any).away?.length > 0) && (
        <p class="te-standings-note">{t.tour.standings_away_note}</p>
      )}
    </div>
  )}
</div>

<script>
  import { stageStatusesOn, tourIsOver } from '../utils/status';
  import { todayLocalIso } from '../utils/today';

  document.querySelectorAll('.te-card--clickable').forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) return;
      const href = (card as HTMLElement).dataset.href;
      if (href) window.open(href, '_blank', 'noopener,noreferrer');
    });
  });

  // Recompute stage statuses client-side, with the build's own rule
  (function () {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.te-card[data-stage-date]'));
    const statuses = stageStatusesOn(
      cards.map((card) => ({
        date: card.dataset.stageDate || '',
        cancelled: card.dataset.stageCancelled === 'true',
        hidden: card.dataset.stageHiddenDate === 'true',
      })),
      todayLocalIso(),
    );

    // Apply
    cards.forEach((card, i) => {
      const status = statuses[i];
      if (status === 'cancelled') return; // keep build-time state
      if (card.dataset.stageHiddenDate === 'true') return; // keep SSR state
      card.classList.remove('te-card--upcoming', 'te-card--completed');
      if (status === 'upcoming') card.classList.add('te-card--upcoming');
      else if (status === 'completed') card.classList.add('te-card--completed');

      const badge = card.querySelector<HTMLElement>('.te-badge');
      if (badge) {
        badge.className = 'te-badge te-badge--' + status;
        badge.textContent = badge.dataset['label' + status.charAt(0).toUpperCase() + status.slice(1)] || status;
      }

      // The registration button takes the stage's colour too (not the "coming soon" one)
      const cta = card.querySelector<HTMLElement>('.te-cta:not(.te-cta--soon)');
      if (cta) cta.className = 'te-cta te-cta--' + status;

      // Swap cover: show real image for non-future, placeholder for future.
      // srcset first: with one set, the browser ignores src.
      const img = card.querySelector<HTMLImageElement>('.te-card-image img');
      if (img?.dataset.realImage) {
        const future = status === 'future';
        const srcset = future ? img.dataset.placeholderSrcset : img.dataset.realSrcset;
        if (srcset) img.srcset = srcset;
        else img.removeAttribute('srcset');
        img.src = future ? img.dataset.realImage.replace(/\d{3}\.webp$/, '000.webp') : img.dataset.realImage;
        img.style.objectPosition = (future ? img.dataset.placeholderPosition : img.dataset.realPosition) || '';
        // The zoom link opens what the card shows.
        img.closest('a.zoomable')?.setAttribute('href', img.src);
      }
    });

    // #prossima / #next: move the marker onto today's upcoming stage (the build may
    // be older), re-scroll if the page was opened on it; hide the link once none is left
    const upcoming = cards[statuses.indexOf('upcoming')];
    const next = document.querySelector<HTMLAnchorElement>('.te-quicknav-next');
    if (next) next.hidden = !upcoming;
    const marker = document.querySelector<HTMLElement>('.te-next-anchor');
    if (marker && upcoming && marker.parentElement !== upcoming) {
      upcoming.prepend(marker);
      if (location.hash === '#' + marker.id) marker.scrollIntoView();
    } else if (marker && !upcoming) marker.remove();

    // Podium: lit once every stage is over, even if the build ran before the last one
    if (tourIsOver(statuses)) {
      document.querySelectorAll<HTMLElement>('.te-standings-table tr[data-rank]').forEach((row) => {
        const rank = Number(row.dataset.rank);
        if (rank <= 1) row.classList.add('te-standings-winner');
        else if (rank <= 3) row.classList.add('te-standings-top');
      });
    }
  })();
</script>
